{# Comments Template - Main wrapper for the comments section #}
{% fetch "comments", amount = 100 %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        TotaltubeComments.init({
            el: '#comments',          
            pageKey: 'c_{{content_item.Id}}', // Unique page key
            server: 'http://localhost:23366',  // Backend server
            site: '{{config.Hostname}}',           // Site name from admin panel
            // Here you can add more options if needed
            all_sites: true,
            locale: '{{ lang.Id }}',
        });
    });
</script>
    <div id="comments">
        <div id="ssr-placeholder" style="display: none;">
            {% for comment in comments.Comments %}
                <div class="comment-item" itemprop="comment" itemscope itemtype="https://schema.org/Comment">
                    <div itemprop="author" itemscope itemtype="https://schema.org/Person">
                        <span itemprop="name">{{ comment.Nick }}</span>
                    </div>
                    <meta itemprop="datePublished" content="{{ comment.Date }}">
                    <div itemprop="text">
                        {{ comment.ContentMarked | safe }}
                    </div>
                    <!-- If we have likes -->
                    <div itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter">
                        <meta itemprop="interactionType" content="https://schema.org/LikeAction"/>
                        <span itemprop="userInteractionCount">{{ comment.VoteUp }}</span>
                    </div>
                    <!-- if we have dislikes -->
                    <div itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter">
                        <meta itemprop="interactionType" content="https://schema.org/DislikeAction"/>
                        <span itemprop="userInteractionCount">{{ comment.VoteDown }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endfetch %}
