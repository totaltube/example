{% if comment.Status != "deleted" or comment.ReplyCount > 0 %}
<li>
    {% set reply_to_name = comment.ReplyToUsername %}
    {% if not reply_to_name and comment.ParentId > 0 and comments and comments.Items %}
        {% for parent_comment in comments.Items %}
            {% if parent_comment.CommentId == comment.ParentId %}
                {% set reply_to_name = parent_comment.Username %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% set is_deleted = comment.Status == "deleted" %}
    {% set deleted_reason = comment.Text|default:"" %}
    {% set deleted_text = translate("Comment deleted") %}
    {% if is_deleted and deleted_reason == "deleted_by_user" %}
        {% set deleted_text = translate("Comment deleted by user") %}
    {% elif is_deleted and deleted_reason == "moderated" %}
        {% set deleted_text = translate("Comment moderated") %}
    {% endif %}
    <div
        class="comment-container{% if comment.ParentId > 0 %} is-reply{% endif %}{% if is_deleted %} comment-deleted{% endif %}"
        id="comment-{{ comment.CommentId }}"
        data-comment-id="{{ comment.CommentId }}"
        data-parent-id="{{ comment.ParentId }}"
        data-reply-count="{{ comment.ReplyCount }}"
        data-direct-reply-total="{{ comment.ReplyCount }}"
        data-reply-to-username="{{ reply_to_name }}"
        data-indent="{{ comment.Indent }}"
        data-status="{{ comment.Status }}"
        data-user-id="{{ comment.UserId }}"
        style="--comment-indent: {{ comment.Indent }};"
        itemscope
        itemtype="https://schema.org/Comment"
    >
        <div class="avatar">
            {% if not is_deleted and comment.Avatar %}
                <img src="{{ comment.Avatar }}" alt="{{ comment.Username }}">
            {% else %}
                <img src="/images/avatar_placeholder.png" alt="User Avatar">
            {% endif %}
        </div>
        <div class="comment-content">
            <div class="comment-header">
                <div class="comment-info">
                    <span class="comment-username" itemprop="author">{% if is_deleted %}{{ translate("Deleted") }}{% else %}{{ comment.Username }}{% endif %}</span>
                    <span class="comment-date" itemprop="datePublished" content="{{ comment.Created.Format("2006-01-02T15:04:05Z07:00") }}">{{ comment.Created.Format("01/02/2006 at 03:04 PM") }}</span>
                    <div class="comment-context{% if comment.ParentId <= 0 %} hidden{% endif %}">
                        {% if comment.ParentId > 0 and not is_deleted %}
                            {% if reply_to_name %}
                                <a class="comment-parent-link" href="#comment-{{ comment.ParentId }}" title="{{ translate("Replying to") }} {{ reply_to_name }}" aria-label="{{ translate("Replying to") }} {{ reply_to_name }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 20V10H9"/><path d="M9 10l4-4"/><path d="M9 10l4 4"/></svg>
                                </a>
                            {% else %}
                                <a class="comment-parent-link" href="#comment-{{ comment.ParentId }}" title="{{ translate("Replying to") }} #{{ comment.ParentId }}" aria-label="{{ translate("Replying to") }} #{{ comment.ParentId }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 20V10H9"/><path d="M9 10l4-4"/><path d="M9 10l4 4"/></svg>
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                {% if not is_deleted %}
                <div class="comment-header-actions">
                    <button class="like-button {% if comment.IsLiked %}active{% endif %}" aria-label="{{ translate("Like") }}">
                        <span class="c-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg></span>
                    </button>
                    {% set score_value = comment.Likes - comment.Dislikes %}
                    {% if score_value > 0 %}
                        <span class="score-count score-positive">{{ score_value }}</span>
                    {% elif score_value < 0 %}
                        <span class="score-count score-negative">{{ score_value }}</span>
                    {% else %}
                        <span class="score-count score-neutral">{{ score_value }}</span>
                    {% endif %}
                    <button class="dislike-button {% if comment.IsDisliked %}active{% endif %}" aria-label="{{ translate("Dislike") }}">
                        <span class="c-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/></svg></span>
                    </button>
                </div>
                {% endif %}
            </div>

            <div class="comment-text" itemprop="text">{% if is_deleted %}{{ deleted_text }}{% else %}{{ comment.Text }}{% endif %}</div>
            <meta itemprop="upvoteCount" content="{{ comment.Likes }}">
            <meta itemprop="downvoteCount" content="{{ comment.Dislikes }}">

            {% if not is_deleted %}
            <div class="comment-actions">
                {% set current_site_id = config.SiteId %}
                {% set is_cross_site = current_site_id > 0 and comment.SiteId > 0 and comment.SiteId != current_site_id %}
                <button class="reply-button {% if comment.Indent >= 10 or is_cross_site %}hidden{% endif %}">{{ translate("Reply") }}</button>
                <button class="delete-button hidden">{{ translate("Delete") }}</button>
                <a class="comment-permalink" href="#comment-{{ comment.CommentId }}" aria-label="Comment link">#</a>
            </div>
            <div class="comment-reply {% if comment.Indent >= 10 or is_cross_site %}hidden{% endif %}">
                <textarea class="comment-input" placeholder="{{ translate("Write a reply...") }}"></textarea>
                <button class="send-comment-button">{{ translate("Reply") }}</button>
            </div>
            {% endif %}
        </div>
    </div>
</li>
{% endif %}
